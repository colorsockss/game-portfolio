{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to PuerTS (Development)",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/idle/client/TypeScript/dist/development/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/idle/client/TypeScript/dist/development/**/*.js.map"],
      "skipFiles": ["**/puerts/**"]
    }
  ]
}
