  "formulas": [
    {
      "id": "d97c8a7d-5589-403b-919f-b4234cae92f1",
      "key": "damage",
      "expression": "max(minDamage, caster.attack - target.defense)",
      "description": "기본 피해량 (샘플)"
    },
    {
      "id": "9ec4786c-d1ad-4f0a-b384-2f282f9b22ce",
      "key": "summonMaxHp",
      "expression": "caster.maxHp * target.maxHpRate * skillLevelRate",
      "description": "소환수의 최대 HP. caster는 소환자의 효과 전 능력치, target은 Summons 행, skillLevel은 소환 스킬의 레벨이고 코드가 내림한다"
    },
    {
      "id": "43a4bda7-f35e-4b40-a8d3-12621107b63d",
      "key": "summonAttack",
      "expression": "caster.attack * target.attackRate * skillLevelRate",
      "description": "소환수의 공격력 (summonMaxHp와 같은 입력)"
    },
    {
      "id": "28182211-ba96-4a0f-bc2b-89f2b139d8a9",
      "key": "summonDefense",
      "expression": "caster.defense * target.defenseRate * skillLevelRate",
      "description": "소환수의 방어력 (summonMaxHp와 같은 입력)"
    },
    {
      "id": "c877c601-a8f8-458a-8b4c-d5e5d91cd878",
      "key": "dotDamage",
      "expression": "floor(caster.attack * power * skillLevelRate)",
      "description": "지속 피해 한 번의 양 (Effects.kind = damage). 걸 때 시전자와 건 스킬의 레벨로 정하고 방어를 무시한다"
    },
    {
      "id": "9c89bfe8-539a-46d2-8af4-69ad4a5d9ab4",
      "key": "heal",
      "expression": "floor(caster.attack * power * skillLevelRate)",
      "description": "회복 한 번의 양 (Effects.kind = heal). 걸 때 시전자와 건 스킬의 레벨로 정한다"
    },
    {
      "id": "2a9c7583-660c-4c09-b2d9-f6054ae8b578",
      "key": "shield",
      "expression": "floor(caster.attack * power * skillLevelRate)",
      "description": "보호막의 흡수량 (Effects.kind = shield). 걸 때 시전자와 건 스킬의 레벨로 정한다"
    },
    {
      "id": "81f63ed8-d846-46d7-a43d-81a68c935fae",
      "key": "statBuff",
      "expression": "power * skillLevelRate",
      "description": "능력치 효과의 비율 (Effects.kind = stat, 0.3 = +30%). 걸 때 정한다. caster는 시전자, target은 효과를 받는 전투원, skillLevel은 건 스킬의 레벨"
    },
    {
      "id": "5e43f6f2-38f3-4625-b184-7a3f260321d1",
      "key": "elementMultiplier",
      "expression": "elementAdvantage > 0 ? elementStrong : elementAdvantage < 0 ? elementWeak : 1",
      "description": "속성 상성 피해 배율. 몬스터에 속성이 생기면 피해에 곱한다(아직 쓰지 않음)"
    },
    {
      "id": "e64f3a2a-87c6-4a7c-94fc-c36077b3cffe",
      "key": "upgradeCost",
      "expression": "floor(upgradeBaseCost * pow(upgradeCostGrowth, step))",
      "description": "강화 비용 (66·68에서 씀): 단계마다 upgradeCostGrowth배"
    },
    {
      "id": "ad1608a6-1d0a-49cf-b976-40851e24b1e0",
      "key": "skillLevelRate",
      "expression": "1 + skillRatePerLevel * (skillLevel - 1)",
      "description": "스킬 레벨의 배율 (1레벨이 1). 피해 배율(skillMultiplier), 효과의 양, 소환수 능력치가 곱한다"
    },
    {
      "id": "a9de8442-36e9-4614-83aa-5d33a2b5af8c",
      "key": "skillMultiplier",
      "expression": "powerMultiplier * skillLevelRate",
      "description": "레벨을 반영한 스킬의 피해 배율. 코드가 기본 피해(damage)에 곱한다(치명이면 치명 배율도 곱한다)"
    },
    {
      "id": "61b03248-f415-4fef-8115-819d1ab4de7b",
      "key": "skillLevelCost",
      "expression": "floor(skillLevelBaseCost * pow(skillLevelCostGrowth, skillLevel - 1))",
      "description": "스킬 레벨을 하나 올리는 비용 (Skills.costItemId 아이템). skillLevel은 올리기 전 레벨"
    },
    {
      "id": "617aa222-bb28-4f93-8920-10da4ef41a91",
      "key": "enhanceCost",
      "expression": "floor(enhanceBaseCost * pow(enhanceCostGrowth, step))",
      "description": "장비 강화 비용 (골드, Constants.goldItemId). step은 지금 단계이고 이 비용으로 한 단계 오른다"
    },
    {
      "id": "9b41e101-3c9c-40d9-af52-8b1f1605d916",
      "key": "enhanceStat",
      "expression": "floor(base * (1 + enhanceStatPerStep * step))",
      "description": "강화한 장비의 스탯 하나. base는 Items의 열, step은 강화 단계"
    },
    {
      "id": "39cbc03a-d7df-49b4-a71a-9093ba797d5a",
      "key": "rebirthPoints",
      "expression": "level >= rebirthMinLevel ? pow(level - rebirthMinLevel + 1, 2) : 0",
      "description": "이 레벨(확정한 영웅 레벨)에서 환생하면 받는 포인트. 0이면 환생할 수 없다"
    },
    {
      "id": "c5fc8669-dbfa-4892-8c02-caefbd3df974",
      "key": "rebirthRate",
      "expression": "1 + rebirthRatePerPoint * points",
      "description": "쌓은 환생 포인트의 영구 배율 (0포인트가 정확히 1). 영웅의 공격·방어·최대 HP와 처치·클리어 보상의 수량(장비는 빼고)에 곱한다"
    }
  ],
