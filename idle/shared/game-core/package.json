{
  "name": "@idle/game-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/** --coverage.reporter=text --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@idle/big-number": "*",
    "@idle/codes": "*",
    "@idle/data-schema": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
