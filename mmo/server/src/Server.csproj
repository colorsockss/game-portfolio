<Project Sdk="Microsoft.NET.Sdk">
  <!-- MMO 서버. 틱 루프 하나가 월드를 고치고, 소켓은 받은 패킷을 큐에 넣고 틱이 만든 버퍼를 보내기만 한다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PortfolioMmo.Server</RootNamespace>
    <AssemblyName>PortfolioMmo.Server</AssemblyName>
    <!-- dotnet run의 작업 디렉터리. 기본 데이터베이스(mmo.sqlite)가 mmo/server/에 생긴다. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)/..</RunWorkingDirectory>
    <!-- GC는 워크스테이션 + 동시 GC(기본값)로 고름(53). 서버 GC는 수집이 드문 대신 한 번의 멈춤이 커(4코어에서 최대 41 ms) 틱 하나에 걸리고 메모리가 4배라 쓰지 않음. 수치는 docs/performance.md. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <ProjectReference Include="../../shared/contract/Contract.csproj" />
    <ProjectReference Include="../../shared/data/Data.csproj" />
    <!-- 피해가 생기기 전(24)에도 체력과 전투 상태를 테스트가 바꿔 회복과 알림을 본다. -->
    <InternalsVisibleTo Include="Server.Tests" />
    <!-- 기획 데이터(바이너리와 해시)를 실행 파일 옆의 data/에 싣는다. 참조하는 프로젝트(테스트, 부하 봇)와 publish에도 따라간다. -->
    <None Include="../../shared/data/files/**" LinkBase="data" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
