<Project Sdk="Microsoft.NET.Sdk">
  <!--
    packets.proto → C#(Packets.cs)과 C++(packets.pb.h, packets.pb.cc). Google.Protobuf.Tools(NuGet)의 protoc 하나로 두 언어를 함께
    generated/에 만들고, 그 파일을 커밋해 Unity와 Unreal이 그대로 쓴다(두 엔진 모두 MSBuild 생성을 쓰지 못함). protoc는 C# 런타임
    (Google.Protobuf)과 Unreal의 libprotobuf(client-unreal/Source/ThirdParty/MmoProtobuf)와 같은 버전이어야 한다. C++ 생성 코드는
    런타임과 버전이 다르면 컴파일되지 않는다. 서버는 이 프로젝트를 참조한다. Unity와 같은 조건(.NET Standard 2.1, C# 9)으로 컴파일해
    생성 코드가 Unity에서도 컴파일되는지 지킨다. 루트의 generate 스크립트가 이 프로젝트를 빌드하고, 검사할 때는 ContractOutputDir를
    다른 폴더로 주고 비교한다.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>PortfolioMmo.Contract</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ContractOutputDir Condition="'$(ContractOutputDir)' == ''">$(MSBuildThisFileDirectory)generated</ContractOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.36.2" PrivateAssets="all" />
    <Compile Include="generated/*.cs" />
    <Compile Include="Units.cs" />
  </ItemGroup>
  <!-- protoc_* 경로는 Google.Protobuf.Tools의 targets가 정한다. macOS용은 x86_64뿐이라 Apple Silicon에서는 Rosetta로 돈다. -->
  <Target Name="GenerateContract" BeforeTargets="BeforeBuild" Inputs="packets.proto" Outputs="$(ContractOutputDir)/Packets.cs;$(ContractOutputDir)/packets.pb.h;$(ContractOutputDir)/packets.pb.cc">
    <PropertyGroup>
      <Protoc Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(protoc_macosx64)</Protoc>
      <Protoc Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(protoc_linux64)</Protoc>
      <Protoc Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(protoc_windows64)</Protoc>
    </PropertyGroup>
    <MakeDir Directories="$(ContractOutputDir)" />
    <Exec Command="&quot;$(Protoc)&quot; --csharp_out=&quot;$(ContractOutputDir)&quot; --cpp_out=&quot;$(ContractOutputDir)&quot; packets.proto" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
